# Copy to an external project-state path, replace every placeholder, and pass
# it with `docker compose --env-file`. Never commit the populated file.
AGENTIC_MESH_V5_RUNTIME_IMAGE=registry.example/agentic-mesh-v5-runtime@sha256:replace
AGENTIC_MESH_V5_WORKER_GENERAL_IMAGE=registry.example/agentic-mesh-v5-worker-general@sha256:replace
AGENTIC_MESH_V5_WORKER_DEVELOPMENT_IMAGE=registry.example/agentic-mesh-v5-worker-development@sha256:replace
AGENTIC_MESH_V5_WORKER_QA_IMAGE=registry.example/agentic-mesh-v5-worker-qa@sha256:replace
AGENTIC_MESH_V5_WORKER_OPERATIONS_IMAGE=registry.example/agentic-mesh-v5-worker-operations@sha256:replace
AGENTIC_MESH_V5_WORKER_UX_IMAGE=registry.example/agentic-mesh-v5-worker-ux@sha256:replace
AGENTIC_MESH_POSTGRES_IMAGE=postgres:17.7-alpine@sha256:replace
AGENTIC_MESH_OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.101.0@sha256:replace

AGENTIC_MESH_CONFIG_HOST_PATH=/home/nich/agentic-mesh-config
AGENTIC_MESH_CODEX_AUTH_FILE=/home/nich/agentic-mesh-system/credentials/codex/auth.json
AGENTIC_MESH_DOCKER_GID=replace-with-output-of-getent-group-docker
AGENTIC_MESH_CONFIG_STATE_PATH=/home/nich/agentic-mesh-projects/agentic-mesh-v5/state/config
AGENTIC_MESH_DOCUMENT_CREDENTIAL_ROOT=/home/nich/agentic-mesh-projects/agentic-mesh-v5/state/credentials/documents
AGENTIC_MESH_GITHUB_CONFIG_PATH=/home/nich/agentic-mesh-projects/agentic-mesh-v5/state/credentials/github
AGENTIC_MESH_POSTGRES_DATA_PATH=/home/nich/agentic-mesh-projects/agentic-mesh-v5/state/postgres
AGENTIC_MESH_POSTGRES_PASSWORD_FILE=/home/nich/agentic-mesh-projects/agentic-mesh-v5/state/secrets/postgres-password
AGENTIC_MESH_PRINCIPALS_FILE=/home/nich/agentic-mesh-projects/agentic-mesh-v5/state/principals.json
AGENTIC_MESH_SOURCE_HOST_PATH=/home/nich/agentic-mesh-projects/agentic-mesh-v5/source/agentic-mesh
AGENTIC_MESH_TOKEN_ROOT=/home/nich/agentic-mesh-projects/agentic-mesh-v5/state/tokens
AGENTIC_MESH_V5_RUNTIME_ENV=/home/nich/agentic-mesh-projects/agentic-mesh-v5/state/runtime.env
AGENTIC_MESH_WORKSPACE_HOST_PATH=/home/nich/agentic-mesh-projects/agentic-mesh-v5/workspaces

AGENTIC_MESH_POSTGRES_DB=agentic_mesh_v5
AGENTIC_MESH_POSTGRES_USER=agentic_mesh
AGENTIC_MESH_V5_PORT=18080
