server {
    listen __LISTEN_ADDRESS__:80;
    server_name __SERVER_NAME__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/agentic-mesh-acme;
        default_type text/plain;
    }

    location / {
        return 404;
    }
}

server {
    listen __LISTEN_ADDRESS__:443 ssl http2;
    server_name __SERVER_NAME__;

    ssl_certificate /etc/letsencrypt/live/__SERVER_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SERVER_NAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/agentic-mesh-teams-access.log;
    error_log /var/log/nginx/agentic-mesh-teams-error.log warn;

    client_max_body_size 2m;

    location = /teams/activity/__INGRESS_TOKEN__ {
        limit_except POST { deny all; }
        if ($http_authorization !~ "^Bearer [A-Za-z0-9._~-]+$") {
            return 401;
        }

        proxy_pass http://127.0.0.1:8100/teams/activity;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }

    location / {
        return 404;
    }
}
