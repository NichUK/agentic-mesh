server {
    listen __LISTEN_ADDRESS__:80;
    server_name __SERVER_NAME__;

    access_log /var/log/nginx/agentic-mesh-teams-access.log;
    error_log /var/log/nginx/agentic-mesh-teams-error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/agentic-mesh-acme;
        default_type text/plain;
    }

    location / {
        return 404;
    }
}
