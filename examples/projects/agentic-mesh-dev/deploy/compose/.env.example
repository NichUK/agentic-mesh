# Copy this file to .env on the deployment host, or provide the same values
# through the host environment before running scripts/release-linuxch-compose.sh.
# Do not commit the filled .env file.

AGENTIC_MESH_WORKSPACE_HOST_PATH=/home/nich/agentic-mesh
AGENTIC_MESH_URL_ROOT=http://linuxch:8100
AGENTIC_MESH_RUNTIME_BUILD_CONTEXT=/home/nich/agentic-mesh
AGENTIC_MESH_SYSTEM_HOST_PATH=/home/nich/agentic-mesh
AGENTIC_MESH_PROJECT_HOST_PATH=/home/nich/agentic-mesh/examples/projects/agentic-mesh-dev
AGENTIC_MESH_CODEX_HOME_HOST_PATH=/home/nich/agentic-mesh/examples/projects/agentic-mesh-dev/state/worker_mounts/codex-agentic-mesh-dev-team-home-q
AGENTIC_MESH_OTEL_COLLECTOR_CONFIG_HOST_PATH=/home/nich/agentic-mesh/config/otel/collector.yaml
AGENTIC_MESH_IMAGE_TAG=agentic-mesh:local
AGENTIC_MESH_ENVIRONMENT=dogfood
COMPOSE_PROJECT_NAME=agentic-mesh

# V3 runtime endpoint and broker state.
AGENTIC_MESH_V3_STATUS_PORT=8100
AGENTIC_MESH_NATS_STATE_HOST_PATH=/home/nich/agentic-mesh/examples/projects/agentic-mesh-dev/state/v3/nats

# Required for the V3 live proof. Values must come from Entra/Graph/OneDrive
# and Bot Framework setup and are intentionally blank in the example.
# AGENTIC_MESH_ONEDRIVE_TOKEN needs delegated Files.ReadWrite.All or Sites.ReadWrite.All.
# Device-code setup should also persist AGENTIC_MESH_GRAPH_REFRESH_TOKEN so the
# runtime can refresh Graph access for the artifact viewer without redeploying.
# AGENTIC_MESH_TEAMS_TOKEN is for admin/bootstrap Graph actions, not runtime
# agent speech. Runtime agent Teams messages use Bot Framework app credentials.
AGENTIC_MESH_ONEDRIVE_TOKEN=
AGENTIC_MESH_ONEDRIVE_DRIVE_ID=
AGENTIC_MESH_GRAPH_CLIENT_ID=
AGENTIC_MESH_GRAPH_TENANT_ID=
AGENTIC_MESH_GRAPH_REFRESH_TOKEN=
AGENTIC_MESH_GRAPH_SCOPES=
AGENTIC_MESH_DASHBOARD_AUTH_ENABLED=true
AGENTIC_MESH_DASHBOARD_AUTH_MODE=entra
AGENTIC_MESH_DASHBOARD_AUTH_TOKEN=
AGENTIC_MESH_DASHBOARD_ALLOWED_USERS=
AGENTIC_MESH_DASHBOARD_USER_HEADERS=Cf-Access-Authenticated-User-Email,X-MS-CLIENT-PRINCIPAL-NAME,X-Forwarded-User
AGENTIC_MESH_DASHBOARD_SESSION_SECRET=
AGENTIC_MESH_DASHBOARD_SESSION_TTL_SECONDS=43200
AGENTIC_MESH_DASHBOARD_ENTRA_CLIENT_ID=
AGENTIC_MESH_DASHBOARD_ENTRA_TENANT_ID=
AGENTIC_MESH_DASHBOARD_ENTRA_SCOPES=openid profile email User.Read
AGENTIC_MESH_DASHBOARD_ENTRA_FLOW=device_code
AGENTIC_MESH_SPONSOR_TEAMS_USER_ID=
AGENTIC_MESH_TEAMS_TOKEN=
AGENTIC_MESH_TEAMS_SENDER_USER_ID=
AGENTIC_MESH_TEAMS_BOT_SERVICE_URL=
AGENTIC_MESH_TENANT_ID=
TEAMS_BOT_PRODUCT_MANAGER_APP_ID=
TEAMS_BOT_PRODUCT_MANAGER_SECRET=
TEAMS_BOT_PROJECT_MANAGER_APP_ID=
TEAMS_BOT_PROJECT_MANAGER_SECRET=
TEAMS_BOT_ENGINEERING_APP_ID=
TEAMS_BOT_ENGINEERING_SECRET=
TEAMS_BOT_QA_ENGINEER_APP_ID=
TEAMS_BOT_QA_ENGINEER_SECRET=
TEAMS_BOT_RELEASE_MANAGER_APP_ID=
TEAMS_BOT_RELEASE_MANAGER_SECRET=

# Override only for a deliberate legacy V2 activation.
# AGENTIC_MESH_RELEASE_SERVICES=v2-runtime v2-teams-ingress v2-supervisor
