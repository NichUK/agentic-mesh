{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "display_name", "packages", "repositories", "documents", "teams", "ado", "credentials", "roles", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"$ref": "#/$defs/id"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_release_digest", "overrides"],
      "properties": {
        "organization_release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "overrides": {"type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^project-override/[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"}}
      }
    },
    "repositories": {"type": "object", "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/repository"}},
    "documents": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/document"}},
    "teams": {"$ref": "#/$defs/teams"},
    "ado": {"$ref": "#/$defs/ado"},
    "credentials": {"type": "object", "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/credential"}},
    "roles": {"type": "object", "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/role"}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_total_instances"],
      "properties": {"max_total_instances": {"type": "integer", "minimum": 1, "maximum": 256}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
    "externalId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "default_branch"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://[^@?#]+\\.git$"},
        "default_branch": {"type": "string", "minLength": 1, "maxLength": 200},
        "credential": {"$ref": "#/$defs/id"},
        "owner_project_id": {"$ref": "#/$defs/id"},
        "authorization_ref": {"type": "string", "pattern": "^grant://"}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "drive_id", "root", "credential"],
      "properties": {
        "adapter": {"$ref": "#/$defs/id"},
        "drive_id": {"$ref": "#/$defs/externalId"},
        "root": {"type": "string", "pattern": "^/"},
        "credential": {"$ref": "#/$defs/id"},
        "owner_project_id": {"$ref": "#/$defs/id"},
        "authorization_ref": {"type": "string", "pattern": "^grant://"}
      }
    },
    "teams": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant_id", "team_id", "credential", "channels"],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/externalId"},
        "team_id": {"$ref": "#/$defs/externalId"},
        "credential": {"$ref": "#/$defs/id"},
        "channels": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/externalId"}
        },
        "owner_project_id": {"$ref": "#/$defs/id"},
        "authorization_ref": {"type": "string", "pattern": "^grant://"}
      }
    },
    "ado": {
      "type": "object", "additionalProperties": false,
      "required": ["organization", "project", "credential"],
      "properties": {
        "organization": {"type": "string", "pattern": "^https://dev\\.azure\\.com/[^/?#]+/?$"},
        "project": {"type": "string", "minLength": 1, "maxLength": 200},
        "credential": {"$ref": "#/$defs/id"},
        "owner_project_id": {"$ref": "#/$defs/id"},
        "authorization_ref": {"type": "string", "pattern": "^grant://"}
      }
    },
    "credential": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "provider", "reference"],
      "properties": {
        "scope": {"enum": ["project", "system"]},
        "provider": {"$ref": "#/$defs/id"},
        "reference": {"type": "string", "pattern": "^(secret|mount|oauth-cache)://"},
        "authorization_ref": {"type": "string", "pattern": "^grant://"}
      }
    },
    "role": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "tool_profile", "instances"],
      "properties": {
        "package": {"type": "string", "pattern": "^role/[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "tool_profile": {"type": "string", "pattern": "^tool-profile/[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "instances": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "integer", "minimum": 0, "maximum": 256},
            "maximum": {"type": "integer", "minimum": 1, "maximum": 256}
          }
        }
      }
    }
  }
}
