{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-mesh.local/schemas/project-v3.schema.json",
  "title": "Agentic Mesh V3 Project Config",
  "type": "object",
  "additionalProperties": true,
  "required": ["project_id", "roles"],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "broker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "adapter": {
          "type": "string",
          "enum": [
            "in-memory",
            "nats-jetstream",
            "rabbitmq",
            "redis-streams",
            "azure-service-bus",
            "kafka",
            "aws-sqs-sns",
            "google-pubsub",
            "filesystem",
            "local"
          ]
        },
        "stream": { "type": "string" },
        "servers": { "type": "string" }
      }
    },
    "document_library": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "adapter": {
          "type": "string",
          "enum": ["onedrive", "sharepoint", "filesystem", "remote-filesystem", "dropbox", "local", "file", "git"]
        },
        "backend": {
          "type": "string",
          "enum": ["onedrive", "sharepoint", "filesystem", "remote-filesystem", "dropbox", "git"]
        },
        "root": { "type": "string" },
        "drive_id": { "type": "string" },
        "root_path": { "type": "string", "default": "/documents" },
        "graph_base_url": { "type": "string", "default": "https://graph.microsoft.com/v1.0" }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "template": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "target_repositories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": { "$ref": "#/$defs/targetRepository" }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "root": { "type": "string" },
        "default_repository": { "type": "string" },
        "repositories": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": { "$ref": "#/$defs/targetRepository" }
        }
      }
    },
    "release_deployment_targets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/releaseDeploymentTarget" }
    },
    "connectors": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "teams": { "$ref": "#/$defs/teamsConnector" }
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "template": { "type": "string" },
          "instances": { "type": "integer", "minimum": 1 },
          "worker": { "$ref": "#/$defs/worker" },
          "instructions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "write_paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "channels": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "primary": { "type": "string" },
              "handoff_inbox": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "worker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "adapter": {
          "type": "string",
          "enum": ["echo", "safe-output-subprocess", "codex-cli"]
        },
        "command": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "model": { "type": "string" },
        "reasoning_effort": { "type": "string" },
        "sandbox_mode": { "type": "string" },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "credential": { "type": "string" }
          }
        }
      }
    },
    "releaseDeploymentTarget": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["command", "no_deployment", "no-deployment", "no-deployment-disposition"]
        },
        "description": { "type": "string" },
        "command": {
          "type": "array",
          "items": { "type": "string" }
        },
        "working_directory": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" },
        "rollback_summary": { "type": "string" },
        "rollback_plan": { "type": "string" }
      }
    },
    "targetRepository": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["git", "filesystem", "local", "remote"]
        },
        "repository_type": {
          "type": "string",
          "enum": ["git", "filesystem", "local", "remote"]
        },
        "path": { "type": "string" },
        "default_branch": { "type": "string" }
      }
    },
    "teamsConnector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "adapter": {
          "type": "string",
          "enum": ["local", "local-teams", "in-memory", "graph", "microsoft-graph", "teams-graph", "teams-bot-connector"]
        },
        "graph_base_url": { "type": "string", "default": "https://graph.microsoft.com/v1.0" },
        "identity_model": { "type": "string" },
        "tenant_id": { "type": "string" },
        "role_bots": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/roleBot" }
        },
        "team": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        }
      }
    },
    "roleBot": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "display_name": { "type": "string" },
        "mention_handle": { "type": "string" },
        "bot_id_ref": { "type": "string" },
        "secret_ref": { "type": "string" }
      }
    }
  }
}
