{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-mesh.local/schemas/response-types.schema.json",
  "title": "Agentic Mesh Response Type Catalog",
  "description": "Schema for reusable human response type templates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["response_types"],
  "properties": {
    "response_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/responseType"
      }
    }
  },
  "$defs": {
    "responseType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "input_mode", "value_type"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input_mode": {
          "type": "string",
          "enum": [
            "choice",
            "number",
            "money",
            "single_line_text",
            "multiline_text",
            "document_reference",
            "url",
            "document_or_url"
          ]
        },
        "value_type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "object"]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": {},
              "label": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "default": []
        },
        "validation": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "ui_hints": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      }
    }
  }
}
