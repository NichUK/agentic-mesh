{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-mesh.local/schemas/architecture-impact.schema.json",
  "title": "Agentic Mesh Architecture Governance Record",
  "description": "Structured architecture-impact and conformance state carried by a V4 work item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture_impact",
    "architecture_impact_rationale",
    "architecture_domains",
    "architecture_conformance"
  ],
  "properties": {
    "architecture_impact": {
      "type": "string",
      "enum": ["not_assessed", "none", "material", "uncertain"]
    },
    "architecture_impact_rationale": {
      "type": "string"
    },
    "architecture_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "business",
          "data",
          "application",
          "integration",
          "technology",
          "security",
          "compliance",
          "governance",
          "operating-model",
          "commercial",
          "cross-project",
          "roadmap"
        ]
      }
    },
    "architecture_reviewer_role": {
      "type": ["string", "null"]
    },
    "architecture_decision_ref": {
      "type": ["string", "null"]
    },
    "architecture_conformance": {
      "type": "string",
      "enum": ["not_required", "pending", "approved", "changes_requested", "exception"]
    },
    "architecture_conformance_rationale": {
      "type": "string"
    },
    "architecture_conformance_decision_ref": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "architecture_impact": {"enum": ["material", "uncertain"]}
        }
      },
      "then": {
        "properties": {
          "architecture_impact_rationale": {"minLength": 1},
          "architecture_domains": {"minItems": 1},
          "architecture_conformance": {
            "enum": ["pending", "approved", "changes_requested", "exception"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "architecture_conformance": {"const": "exception"}
        }
      },
      "then": {
        "required": ["architecture_conformance_decision_ref"],
        "properties": {
          "architecture_conformance_decision_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
