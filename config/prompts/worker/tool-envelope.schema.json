{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Mesh V3 Safe-Output Operational Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_calls"],
  "properties": {
    "tool_calls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_name", "call_id", "terminal"],
        "properties": {
          "tool_name": {
            "type": "string",
            "minLength": 1
          },
          "call_id": {
            "type": "string",
            "minLength": 1
          },
          "terminal": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
